<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
{% set bodyClasses = ["homepage"] if page.url == "/" else [] %}
<body class="{{ bodyClasses | join(' ') }}">
  {% if page.url == "/" %}
  <header class="site-header">
    <div class="avatar-placeholder" id="headerAvatar"></div>
    <div class="site-title-group">
      <h1 class="site-title">{{ title }}</h1>
      {% if metadata.tagline %}
      <p class="site-tagline">{{ metadata.tagline }}</p>
      {% endif %}
      <div class="dos-typing-container">
        <span id="dos-typing"><span class="dos-cursor">█</span></span>
      </div>
    </div>
  </header>
  {% include "site-nav.njk" %}
  <div class="layout-main">
    <main class="content">
      {{ content | safe }}
    </main>
  </div>
  {% else %}
  {% include "site-nav.njk" %}
  <div class="page layout-main">
    <main class="content">
      {% if date %}
      <div class="post-date-container">
        <span id="post-date-typing" class="post-date-typing" data-date="{{ date.toISOString().split('T')[0] }}"></span>
      </div>
      {% endif %}
      <h1 class="site-title">{{ title }}</h1>
      {{ content | safe }}
      {# Conditional post CTA for posts from 2010 or newer #}
      {% if date and page.url and page.url.startsWith('/posts/') and date.getFullYear() >= 2010 %}
      {% include 'post-cta.njk' %}
      {% endif %}
    </main>
  </div>
  {% endif %}
  <div class="page">
    {% include "footer.njk" %}
  </div>
  <script src="/js/site.js"></script>
</body>
</html>
