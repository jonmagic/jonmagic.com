{%- set analyticsPageType = analyticsType or "page" -%}
{%- if page.url == "/" -%}
  {%- set analyticsPageType = "home" -%}
{%- elif page.url and page.url.startsWith("/posts/") and date -%}
  {%- set analyticsPageType = "post" -%}
{%- elif page.url == "/posts/" -%}
  {%- set analyticsPageType = "writing_index" -%}
{%- elif page.url == "/projects/" -%}
  {%- set analyticsPageType = "projects_index" -%}
{%- elif page.url and page.url.startsWith("/merch/") -%}
  {%- set analyticsPageType = "merch" -%}
{%- elif page.url == "/search/" -%}
  {%- set analyticsPageType = "search" -%}
{%- elif page.url == "/about/" -%}
  {%- set analyticsPageType = "about" -%}
{%- elif page.url == "/tsrs/" -%}
  {%- set analyticsPageType = "project" -%}
{%- elif page.url == "/eli5/" -%}
  {%- set analyticsPageType = "tool" -%}
{%- endif -%}
<script defer data-domain="jonmagic.com" src="https://plausible.io/js/script.pageview-props.outbound-links.js"
  event-page_type="{{ analyticsPageType }}"
  event-page_slug="{{ page.fileSlug or 'home' }}"
  {%- if page.url %} event-path="{{ page.url }}"{% endif %}
  {%- if date %} event-year="{{ date.getFullYear() }}"{% endif %}
  {%- if analyticsProject %} event-project="{{ analyticsProject }}"{% endif %}
  {%- if analyticsTopic %} event-topic="{{ analyticsTopic }}"{% endif %}></script>
<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>

{# Open Graph meta tags for social media link previews #}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ metadata.description }}{% endif %}">
<meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ metadata.title }}">
<meta property="og:type" content="{% if date %}article{% else %}website{% endif %}">
<meta property="og:image" content="{{ metadata.url }}{% if avatar %}{{ avatar }}{% else %}/images/avatars/jonmagic-2023-01-18.webp{% endif %}">
<meta property="og:locale" content="en_US">

{# Twitter Card meta tags #}
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{% if description %}{{ description }}{% else %}{{ metadata.description }}{% endif %}">

{# Standard meta tags #}
<meta name="description" content="{% if description %}{{ description }}{% else %}{{ metadata.description }}{% endif %}">
<meta name="author" content="{{ metadata.author.name }}">

<link rel="icon" href="/favicon.ico" type="image/x-icon">
{# <link rel="icon" href="/animated-favicon.gif" type="image/gif"> #}
<link rel="stylesheet" href="/css/index.css">
{%- if kit and kit.length %}
<link rel="stylesheet" href="/css/post-kit.css">
{%- elif eyebrow %}
<link rel="stylesheet" href="/css/post-kit.css">
{%- endif %}
<link rel="alternate" type="application/atom+xml" title="JonMagic.com RSS Feed" href="/feed.xml">
