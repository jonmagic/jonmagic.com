<aside class="post-cta" aria-labelledby="post-cta-heading">
  <h2 id="post-cta-heading" class="post-cta-heading">Thanks for reading</h2>
  <ul class="post-cta-actions">
    <li><a href="https://news.ycombinator.com/submitlink?u={{ (metadata.url + page.url) | url }}&t={{ title | url }}" rel="noopener noreferrer" target="_blank" data-plausible-event-name="outbound-cta" data-plausible-event-target="hn-submit">Share on Hacker News</a></li>
    <li><a href="https://github.com/jonmagic/jonmagic.com/discussions" data-plausible-event-name="outbound-cta" data-plausible-event-target="site-discussions">Start a discussion</a></li>
    <li><a href="/posts/" data-plausible-event-name="internal-cta" data-plausible-event-target="cta-to-posts">More writing</a></li>
    <li><a href="/projects/" data-plausible-event-name="internal-cta" data-plausible-event-target="cta-to-projects">Projects</a></li>
    <li><a href="https://github.com/jonmagic" data-plausible-event-name="outbound-cta" data-plausible-event-target="github-jonmagic">Follow on GitHub</a></li>
  </ul>

  {%- set merchTile = false -%}
  {%- if merch -%}
    {%- for item in collections.merch -%}
      {%- if item.fileSlug == merch -%}{%- set merchTile = item -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if merchTile -%}
  <a class="post-merch-cta post-merch-cta--contextual post-merch-cta--{{ merchTile.data.shirt_color or 'cream' }}{% if merchTile.data.image_dark %} post-merch-cta--theme-aware{% endif %}"
     href="/merch/#{{ merchTile.fileSlug }}"
     aria-label="{{ merchTile.data.title }}. See it in the merch shop."
     data-plausible-event-name="internal-cta"
     data-plausible-event-target="post-merch-{{ merchTile.fileSlug }}">
    <picture>
      {%- if merchTile.data.image_dark -%}
      <source media="(prefers-color-scheme: dark)" srcset="{{ merchTile.data.image_dark }}">
      {%- endif -%}
      <img class="post-merch-thumb" src="{{ merchTile.data.image }}" alt="" width="120" height="132" loading="eager">
    </picture>
    <span class="post-merch-copy">
      <strong>{{ merchTile.data.title }}</strong>
      <span>See it in the merch shop →</span>
    </span>
  </a>
  {%- elif not disableMerchCta -%}
  <a class="post-merch-cta"
     href="/merch/"
     aria-label="Browse jonmagic.com merch"
     data-plausible-event-name="internal-cta"
     data-plausible-event-target="post-merch-shop">
    <span class="post-merch-copy">
      <strong>Browse current merch designs</strong>
      <span>Browse the merch shop →</span>
    </span>
  </a>
  {%- endif -%}
</aside>
