---
layout: layout
title: jonmagic.com merch
description: Small-batch developer shirts available on TeePublic.
---

<p class="page-lede">
  Small-batch developer shirts from my actual workflows, original ideas,
  and AI-assisted design experiments. They are available on TeePublic now,
  with variants linked from each design.
</p>

<div class="merch-grid">
  {%- for item in collections.merch -%}
  <article id="{{ item.fileSlug }}" class="merch-tile merch-tile--{{ item.data.shirt_color or 'cream' }}">
    {%- set productUrl = item.data.product_url or item.data.teepublic_url -%}
    {%- if productUrl -%}
    <a class="merch-tile-preview{% if item.data.image_dark %} merch-tile-preview--theme-aware{% endif %}"
       href="{{ productUrl }}"
       target="_blank"
       rel="noopener"
       data-plausible-event-name="outbound-cta"
       data-plausible-event-target="merch-{{ item.fileSlug }}"
       aria-label="{{ item.data.title }} on TeePublic">
      <picture>
        {%- if item.data.image_dark -%}
        <source media="(prefers-color-scheme: dark)" srcset="{{ item.data.image_dark }}">
        {%- endif -%}
        <img src="{{ item.data.image }}"
             alt="{{ item.data.title }} design preview"
             loading="lazy"
             width="800"
             height="880">
      </picture>
    </a>
    {%- else -%}
    <div class="merch-tile-preview{% if item.data.image_dark %} merch-tile-preview--theme-aware{% endif %}">
      <picture>
        {%- if item.data.image_dark -%}
        <source media="(prefers-color-scheme: dark)" srcset="{{ item.data.image_dark }}">
        {%- endif -%}
        <img src="{{ item.data.image }}"
             alt="{{ item.data.title }} design preview"
             loading="lazy"
             width="800"
             height="880">
      </picture>
    </div>
    {%- endif -%}
    <div class="merch-tile-body">
      <h2 class="merch-tile-title">{{ item.data.title }}</h2>
      {%- if item.data.description -%}
      <p class="merch-tile-blurb">{{ item.data.description }}</p>
      {%- endif -%}
      {%- if item.data.colorways and item.data.colorways.length -%}
      <p class="merch-tile-colorways">
        <span class="merch-tile-label">colorways</span>
        {{ item.data.colorways | join(" · ") }}
      </p>
      {%- endif -%}
      {%- if item.data.variants and item.data.variants.length -%}
      <div class="merch-variants" aria-label="{{ item.data.title }} variants">
        {%- for variant in item.data.variants -%}
        {%- set variantUrl = variant.product_url or variant.teepublic_url -%}
        <figure class="merch-variant merch-tile--{{ variant.shirt_color or item.data.shirt_color or 'cream' }}">
          {%- if variantUrl -%}
          <a class="merch-variant-preview"
             href="{{ variantUrl }}"
             target="_blank"
             rel="noopener"
             data-plausible-event-name="outbound-cta"
             data-plausible-event-target="merch-{{ item.fileSlug }}-variant-{{ loop.index }}"
             aria-label="{{ item.data.title }} {{ variant.name }} on TeePublic">
            <img src="{{ variant.image }}"
                 alt="{{ item.data.title }} {{ variant.name }} variant"
                 loading="lazy"
                 width="360"
                 height="396">
          </a>
          {%- else -%}
          <div class="merch-variant-preview">
            <img src="{{ variant.image }}"
                 alt="{{ item.data.title }} {{ variant.name }} variant"
                 loading="lazy"
                 width="360"
                 height="396">
          </div>
          {%- endif -%}
          <figcaption>
            {%- if variantUrl -%}
            <a class="merch-variant-name" href="{{ variantUrl }}" target="_blank" rel="noopener">{{ variant.name }}</a>
            {%- else -%}
            <span class="merch-variant-name">{{ variant.name }}</span>
            {%- endif -%}
            {%- if variant.description -%}
            <span class="merch-variant-desc">{{ variant.description }}</span>
            {%- endif -%}
          </figcaption>
        </figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
      <p class="merch-tile-actions">
        {%- if productUrl -%}
        <a class="merch-tile-buy"
           href="{{ productUrl }}"
           target="_blank"
           rel="noopener"
           data-plausible-event-name="outbound-cta"
           data-plausible-event-target="merch-{{ item.fileSlug }}-buy">View on TeePublic →</a>
        {%- else -%}
        <a class="merch-tile-buy"
           href="https://www.teepublic.com/user/jonmagic"
           target="_blank"
           rel="noopener"
           data-plausible-event-name="outbound-cta"
           data-plausible-event-target="merch-{{ item.fileSlug }}-shop">Browse TeePublic shop →</a>
        {%- endif -%}
        {%- if item.data.originating_post -%}
        <a class="merch-tile-source" href="{{ item.data.originating_post }}">From this post →</a>
        {%- endif -%}
      </p>
    </div>
  </article>
  {%- endfor -%}
</div>

<p class="merch-footnote">
  If anything looks off, email me at
  <a href="mailto:jonmagic@gmail.com">jonmagic@gmail.com</a> and I will help.
</p>
